# 火山引擎「声音复刻」凭证（控制台开通：语音技术 → 声音复刻）
# 全部填**你自己**的账号与音色——本文件填真值后改名 .env（.env 已在 .gitignore，绝不提交/外传）
VOLC_APPID=
VOLC_ACCESS_TOKEN=
VOLC_CLUSTER=volcano_icl
# ↑ 声音复刻用 volcano_icl；没有克隆音想先跑通：改成控制台标注的标准音色 cluster（一般 volcano_tts），
#   下面 SPEAKER_ID 填标准音色的 voice_type 即可
# 你自己克隆的音色 ID（S_ 开头）——这就是全片的声音
VOLC_SPEAKER_ID=
